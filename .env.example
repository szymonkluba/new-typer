# REQUIRED: Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-hex-string

# SQLite database path inside the container (volume-mounted)
DATABASE_URL=sqlite:////data/typer.db

# Optional: override scraper schedule
# SCRAPER_COMPETITIONS_CRON_HOUR=6
# SCRAPER_RESULTS_INTERVAL_HOURS=2
